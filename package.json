{
  "name": "hireready",
  "version": "1.0.0",
  "private": true,
  "description": "HireReady checks a resume against what applicant tracking software and recruiters look at first. Runs entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Arshdeep Singh Grover",
  "homepage": "https://hireready.arshdeepgrover.dev",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke",
    "assets": "node scripts/generate-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "clean": "rm -rf dist .tmp node_modules/.vite",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "bash scripts/verify-browser.sh",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArshdeepGrover/HireReady.git"
  },
  "bugs": {
    "url": "https://github.com/ArshdeepGrover/HireReady/issues"
  },
  "keywords": [
    "resume",
    "ats",
    "resume-checker",
    "applicant-tracking-system",
    "career",
    "privacy",
    "pdfjs",
    "vite",
    "typescript"
  ]
}
